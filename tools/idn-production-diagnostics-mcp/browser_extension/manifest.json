{
  "manifest_version": 3,
  "name": "IDN Production Log Bridge",
  "version": "0.1.0",
  "description": "Read-only bridge for Indonesia production Kibana diagnostics.",
  "permissions": ["scripting", "tabs", "alarms"],
  "host_permissions": [
    "https://log.rupiahcepatweb.com/*",
    "http://127.0.0.1:18765/*"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "IDN Production Log Bridge"
  }
}
